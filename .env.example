# Copy to .env and fill in real values. Never commit .env.
#
# Copilot CLI does NOT auto-load .env. Export these in your shell before
# running `copilot` in this repo, e.g.:
#
#   set -a; source .env; set +a
#   copilot

# Daily Dose REST API — the downstream API the extension's add_quote tool calls.
DAILY_DOSE_API_URL=
DAILY_DOSE_API_TOKEN=
